# Perfil activo: local (por defecto) | azure
SPRING_PROFILES_ACTIVE=local

# Solo necesario si SPRING_PROFILES_ACTIVE=azure
# Cadena de conexion de Azure Blob Storage (Azure Portal > Storage Account > Access keys)
AZURE_STORAGE_CONNECTION_STRING=
# Nombre del contenedor donde se guardan los archivos multimedia
AZURE_STORAGE_CONTAINER_NAME=umarket-media

# Opcional, solo para perfil local: carpeta donde se guardan los archivos
UMARKET_STORAGE_LOCAL_PATH=./uploads